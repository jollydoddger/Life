<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Updating itself (WatchUpdate), so a new build no longer needs ADB.
         The second lets a self-update skip the confirmation where Android
         allows it (13 and up); it is a normal permission and asks nothing. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- Runs without the phone: GPS is on the wrist and tiles are synced
             ahead. The phone is only where GPX files and the key come from. -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />
        <uses-library
            android:name="com.google.android.wearable"
            android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Receives the route + tiles + key the phone puts on the Data
             Layer, whether or not the app is open. -->
        <service
            android:name=".WaymarkListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/waymark" />
            </intent-filter>
        </service>

        <!-- Keeps the trail growing with the screen off. Only ever started
             from the visible app, which is what keeps this clear of
             ACCESS_BACKGROUND_LOCATION. -->
        <service
            android:name="com.jollydoddger.waymark.shared.TrackingService"
            android:exported="false"
            android:foregroundServiceType="location" />
        <!-- The installer's verdict on an update. Reached only through our
             own explicit PendingIntent, so it is not exported. -->
        <receiver
            android:name=".InstallResultReceiver"
            android:exported="false" />
    </application>
</manifest>
