<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Hold-to-talk needs the recording under this app's control. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- The sun view draws its arc over the camera. Optional in both
         senses: not required to install, and refusing it just swaps the
         camera for a plain sky. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- Load-bearing (a loose-ends lesson): without declaring interest, the
         speech recogniser is invisible from Android 11 and the mic reports
         "no recogniser" on a phone that plainly has one. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".WaymarkApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Opening a .gpx from a file manager or a download lands here. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="application/gpx+xml" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/gpx+xml" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

        <activity
            android:name=".SunActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Hour by hour for wherever the map is. Its own screen because a
             column of numbers is not something a map can show: an overlay
             answers "where is the rain", this answers "what at four". -->
        <activity
            android:name=".WeatherActivity"
            android:exported="false" />

        <!-- The whole conversation. Its own screen because a transcript over
             a map is either too small to read or too big to see past. -->
        <activity
            android:name=".ChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Hands one exported GPX at a time to the share sheet. Not
             exported: targets reach it only through the temporary grant the
             share Intent carries. -->
        <provider
            android:name=".ShareProvider"
            android:authorities="com.jollydoddger.waymark.share"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- Keeps the trail growing with the screen off. Only ever started
             from the visible app, which is what keeps this clear of
             ACCESS_BACKGROUND_LOCATION. -->
        <service
            android:name="com.jollydoddger.waymark.shared.TrackingService"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>
</manifest>
